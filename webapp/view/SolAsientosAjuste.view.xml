<mvc:View controllerName="com.carrefour.solicitudasientosajuste.controller.SolAsientosAjuste"
     xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">
    <Page id="page" title="{i18n>title}">
    <content>

            <VBox id="VB1" class="sapUiSmallMargin">

                <f:Form id="FormDisplay480_12120Dual" editable="false" class="myFormBackground">
                    <f:title>
                        <core:Title text="SOLICITUD DE ASIENTO" id="tt1" />
                    </f:title>

                    <f:layout>
                        <f:ResponsiveGridLayout id="tr1"
                            labelSpanXL="4"
                            labelSpanL="4"
                            labelSpanM="12"
                            labelSpanS="12"
                            adjustLabelSpan="false"
                            emptySpanXL="0"
                            emptySpanL="0"
                            emptySpanM="0"
                            emptySpanS="0"
                            columnsXL="4"
                            columnsL="4"
                            columnsM="2"
                            singleContainerFullSize="false" />
                    </f:layout>

                    <f:formContainers>

                        <!-- Columna 1 -->
                        <f:FormContainer id="lt2">
                            <f:formElements>
                                <f:FormElement id="m1">
                                    <f:fields>
                                        <l:VerticalLayout id="v1" class="lVerticalLayoutClass" width="100%">
                                            <Label id="lblsolicitante" text="Solicitante" labelFor="txtsolicitante" class="tightLabel" />
                                            <Input id="txtsolicitante" value="{correo_solicitante}" placeholder="Solicitante" showSuggestion="true" required="true" editable="false" />

                                            <Label id="lblSector" text="Sector" labelFor="txtsector" class="tightLabel" />
                                            <ComboBox
                                                id="cbSector"
                                                width="100%"
                                                required="true"
                                                selectedKey="{sectorSolicitante_ID}"
                                                items="{
                                                    path: 'catalog>/Sectores',
                                                    parameters: { $select: 'ID,nombre' },
                                                     sorter: {path: 'nombre',descending: false}
                                                }">
                                                <core:Item key="{catalog>ID}" text="{catalog>nombre}" />
                                            </ComboBox>

                                            <Label id="lblsociedad" text="Sociedad" labelFor="txtsociedad"/>
                                            <Input id="txtsociedad" value="{sociedad}" placeholder="Sociedad" showSuggestion="true" required="true" editable="false"/>

                                        </l:VerticalLayout>
                                    </f:fields>
                                </f:FormElement>
                            </f:formElements>
                        </f:FormContainer>

                        <!-- Columna 2 -->
                        <f:FormContainer id="lt5">
                            <f:formElements>
                                <f:FormElement id="f4">
                                    <f:fields>
                                        <l:VerticalLayout id="v2" class="lVerticalLayoutClass" width="100%">
                                            
                                            <Label id="lblMoneda" text="Moneda" labelFor="txtMoneda" />
                                            <ComboBox value="{moneda}" id="txtMoneda" width="100%" required="true" selectionChange="onMonedaChange">
                                            <items>
                                                <core:Item id="M1" key="1" text="ARS"/>
                                                <core:Item id="M2" key="USD" text="USD"/>
                                                <core:Item id="M3" key="EUR" text="EUR"/>
                                            </items>
                                            </ComboBox>
                                            
                                            <Label id="lblclasedoc" text="Clase Documento" labelFor="txtClaseDocumento" />
                                            <Input id="txtClaseDocumento" value="{claseDocumento}" placeholder="Ingresar Clase Documento" showSuggestion="true" required="true" editable="false"/>

                                            <Label id="lblPeriodo" text="Período/Año" labelFor="txtPeriodo" />
                                            <MaskInput id="txtPeriodo" placeholder="MM/YYYY" mask="99/9999" required="true" width="10rem">
                                                <rules>
                                                    <MaskInputRule id="mir1" maskFormatSymbol="9" regex="[0-9]" />
                                                </rules>
                                            </MaskInput>
                                        
                                        </l:VerticalLayout>
                                    </f:fields>
                                </f:FormElement>
                            </f:formElements>
                        </f:FormContainer>

                        <!-- Columna 3 -->
                        <f:FormContainer id="lt43">
                            <f:formElements>
                                <f:FormElement id="f433">
                                    <f:fields>
                                        <l:VerticalLayout id="v3" class="lVerticalLayoutClass" width="100%">
                                             <Label id="lblFechaConta" text="Fecha Contabilización" labelFor="dpFechaConta" />
                                            <!-- <Input id="txtFechaConta" placeholder="Ingresar Fecha Contabilizacion" showSuggestion="true" /> -->
                                         <DatePicker id="dpFechaConta" value="{fechaContabilizacion}" valueFormat="yyyy-MM-dd"  displayFormat="dd.MM.yyyy"   placeholder="Seleccione una fecha" change="onFechaChange" required="true" />

                                             <Label id="lblFechaDoc" text="Fecha Documento" labelFor="dpFechaDoc" />
                                             <!-- <Input id="txtFechaDoc" placeholder="Ingresar Fecha Documento" showSuggestion="true" /> -->
                                            <DatePicker id="dpFechaDoc"  value="{fechaDocumento}" valueFormat="yyyy-MM-dd"  displayFormat="dd.MM.yyyy"  placeholder="Seleccione una fecha" change="onFechaChange" required="true"/>

                                             <Label id="lblTipoAsiento" text="Tipo Asiento" labelFor="cbTipoAsiento" />
                                            <ComboBox
                                                id="cbTipoAsiento"
                                                width="100%"
                                                required="true"
                                                selectedKey="{tipoAsiento_ID}"
                                                items="{
                                                    path: 'catalog>/TiposAsiento',
                                                    parameters: { $select: 'ID,nombre' }
                                                }">
                                                <core:Item key="{catalog>ID}" text="{catalog>nombre}" />
                                            </ComboBox>

                                        </l:VerticalLayout>
                                    </f:fields>
                                </f:FormElement>
                            </f:formElements>
                        </f:FormContainer>

                        <!-- Columna 4 -->
                        <f:FormContainer id="lt433">
                            <f:formElements>
                                <f:FormElement id="f4331">
                                    <f:fields>
                                        <l:VerticalLayout id="v4" class="lVerticalLayoutClass"  width="100%">
                                            <Label id="lblTextocabecera" text="Texto Cabecera" labelFor="txttextocabecera" />
                                            <Input id="txttextocabecera"  value="{textoCabecera}" placeholder="Ingrese el texto" showSuggestion="true" required="true" maxLength="25"/>
                                        
                                            <!-- 🆕 Tipo de Cambio, debajo de Texto Cabecera -->
                                       <Label id="lblTipoCambio" text="Tipo de Cambio" labelFor="txtTipoCambio" />
                                       <Input id="txtTipoCambio" value="{ path: 'tipoCambio', targetType: 'any'}" placeholder="Ingrese el tipo de cambio" liveChange="onTipoCambioLiveChange"/>
                                        
                                        </l:VerticalLayout>
                                    </f:fields>
                                </f:FormElement>
                            </f:formElements>
                        </f:FormContainer>

                    </f:formContainers>
                </f:Form>

                <Panel id="p2" headerText="Asientos Contables" expandable="false" class="myFormBox">
        <Toolbar id="t1">
            <ToolbarSpacer id="tsp"/>
            <!-- <Button id="btd" icon="sap-icon://delete" press="onLimpiar"/> -->
            <unified:FileUploader id="fileUploaderExcel"
                                  name="excelUploader"
                                  buttonOnly="true"
                                  uploadOnChange="false"
                                  fileType="xlsx,xls"
                                  change="onFileChange"
                                  xmlns:unified="sap.ui.unified"
                                  icon="sap-icon://excel-attachment"
                                  tooltip="Adjuntar Excel de Asientos"
                                  iconOnly="true"/>
            <unified:FileUploader id="fileUploaderAdjunto"
                          name="adjuntoUploader"
                          buttonOnly="true"
                          uploadOnChange="false"
                          fileType="xls,xlsx,pdf,jpg,jpeg,png"
                          change="onFileChangeAdjunto"
                          xmlns:unified="sap.ui.unified"
                          icon="sap-icon://attachment"
                          tooltip="Adjuntar PDF o Imagen"
                          iconOnly="true"/>
        </Toolbar>
        <!-- Aquí viene la tabla -->
        <ScrollContainer id="sc1" height="12rem" vertical="true" horizontal="false">
    <Table id="tblItems" inset="false" 	items="{
						parameters : {
							$count : true,
							$$ownRequest : true
						},
						path : 'items'
					}"
    growing="true" growingScrollToLoad="true">
        <columns>
            <Column id="c1" width="4rem">
                <Text id="txtnroasiento" text="Nro Asiento" class="miHeaderColumna"/>
            </Column>
            <Column id="c2" width="7rem">
                <Text id="txtClave" text="Clave (Debe/Haber)" class="miHeaderColumna"/>
            </Column>
            <Column id="c3" width="8rem">
                <Text id="txtcuentacontable" text="Cuenta Contable" class="miHeaderColumna"/>
            </Column>
             <Column id="c4" width="37rem">
                <Text id="txtDescripcioncuentacontable" text="Descripcion" class="miHeaderColumna"/>
            </Column>
            <Column id="c5" width="8rem">
                <Text id="txtimporte" text="Importe" textAlign="Center" class="miHeaderColumna"/>
            </Column>
            <Column id="c6" width="7rem">
                <Text id="txtcentrocoste" text="CECO" textAlign="Center" class="miHeaderColumna"/>
            </Column>
        </columns>
        <items>
            <ColumnListItem id="ci1">
                <cells>
                    <Input id="it1" value="{numeroLinea}" width="100%" class="miInputChico" required="true" editable="false"/>
                    <Input id="it2" value="{clave}" width="100%" class="miInputChico" required="true" editable="false"/>
                    <Input id="it3" value="{cuentaContable_ID}" width="100%" class="miInputChico" required="true" editable="false"/>
                    <Input id="it4" value="{descripcion}" width="100%" class="miInputChico" required="true" editable="false"/>
                    <Input id="it5" value="{importe}" width="100%" class="miInputChico" required="true" editable="false"/>
                    <Input id="it6" value="{centroCosto}" width="100%" class="miInputChico" required="true" editable="false"/>
                </cells>
            </ColumnListItem>
            <!-- puedes agregar más filas desde el controller -->
        </items>
    </Table>
    </ScrollContainer>

            <ScrollContainer visible="false" id="scadjuntosSolicitud" height="12rem" vertical="true" horizontal="false">
            <Table id="tbladjuntosSolicitud" inset="false" items="{
                                parameters : {
                                    $count : true,
                                    $$ownRequest : true
                                },
                                path : 'adjuntosSolicitud'
                            }"
            growing="true" growingScrollToLoad="true">
                <columns>
                    <Column id="cidentificadorAdjunto" width="4rem">
                        <Text id="txtidentificadorAdjunto" text="Identificador" class="miHeaderColumna"/>
                    </Column>
                    <Column id="cnombreAdjunto" width="7rem">
                        <Text id="txtnombreAdjuntoe" text="Nombre" class="miHeaderColumna"/>
                    </Column>
                </columns>
                <items>
                    <ColumnListItem id="ciidentificadorAdjunto">
                        <cells>
                            <Input id="itidentificadorAdjunto" value="{identificadorAdjunto}" width="100%" class="miInputChico" required="true" editable="false"/>
                            <Input id="itnombreAdjunto" value="{nombreAdjunto}" width="100%" class="miInputChico" required="true" editable="false"/>
                        </cells>
                    </ColumnListItem>
                    <!-- puedes agregar más filas desde el controller -->
                </items>
            </Table>
        </ScrollContainer>
    </Panel>
    <!-- Botón Confirmar alineado a la derecha -->
    <HBox id="hb1" justifyContent="End" class="sapUiSmallMarginTop">
        <Button id="btEnvio" press=".onSave" text="Confirmar Envío"/>
    </HBox>

            </VBox>
            
        </content>
    </Page>
</mvc:View>